{
  "name": "webdriverio-sandbox-typescript",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-platform E2E testing template (web, Android, iOS) based on WebdriverIO v10",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "volta": {
    "node": "22.15.0"
  },
  "scripts": {
    "wdio:ios:web": "wdio run ./config/wdio.ios.web.conf.ts",
    "wdio:ios:native": "wdio run config/wdio.ios.native.conf.ts",
    "wdio:android:web": "wdio run config/wdio.android.web.conf.ts",
    "wdio:android:native": "wdio run config/wdio.android.native.conf.ts",
    "wdio:web:edge": "wdio run ./config/wdio.web.edge.conf.ts",
    "typecheck": "tsc --noEmit",
    "report": "allure serve allure-results",
    "setup:apps": "node scripts/setup-apps.js",
    "setup:apps:android": "node scripts/setup-apps.js --android-only",
    "setup:apps:ios": "node scripts/setup-apps.js --ios-only"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@wdio/allure-reporter": "10.0.1",
    "@wdio/appium-service": "10.0.2",
    "@wdio/cli": "10.0.2",
    "@wdio/globals": "10.0.2",
    "@wdio/local-runner": "10.0.2",
    "@wdio/mocha-framework": "10.0.1",
    "@wdio/visual-service": "11.0.0",
    "allure-commandline": "2.46.1",
    "appium-uiautomator2-driver": "8.7.0",
    "appium-xcuitest-driver": "12.17.1",
    "deepmerge-ts": "^8.0.2",
    "dotenv": "^17.4.2",
    "expect-webdriverio": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "webdriverio": "10.0.2"
  },
  "packageManager": "yarn@4.18.1"
}
